<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#14161B</item>
        <item name="android:statusBarColor">#14161B</item>
        <item name="android:navigationBarColor">#14161B</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
